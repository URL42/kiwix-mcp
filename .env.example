# Copy to .env (compose reads it automatically). Every value has a default in
# docker-compose.yml, so this file only needs lines you want to change.

# LAN-facing ports. Containers always listen on 8080 (kiwix-serve) and 8000
# (MCP) internally.
# KIWIX_HOST_PORT=8078
# MCP_HOST_PORT=8076

# Where ZIMs live on the host. Must already exist (see README).
# KIWIX_DATA_DIR=/mnt/sata/kiwix

# refresh.py refuses any download that would leave less than this free on the
# drive, to protect the databases that share it.
# MIN_FREE_GB=200

# Host user the refresh container runs as (`id -u` / `id -g` on bossbitch).
# PUID=1000
# PGID=1000

# Only needed when running server.py outside compose (local dev):
# KIWIX_URL=http://192.168.1.238:8078
# MCP_PORT=8000
